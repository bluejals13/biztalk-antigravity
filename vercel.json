{
  "version": 2,
  "builds": [
    {
      "src": "FastApi/app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "FastApi/app/main.py"
    },
    {
      "src": "/health",
      "dest": "FastApi/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/FastApi/frontend/$1"
    }
  ]
}